# Course PDFs (local only)
/*.pdf

# Per-person profile, memory and environment
.env
.venv/
local/
CLAUDE.local.md
.claude/settings.local.json

# Downloaded datasets (re-created by a download script); generated data elsewhere in data/ is committed,
# except the verifier's candidate lists (large; re-created by python -m squadqa.candidates)
data/external/
data/verifier/

# Slurm logs (the directory itself is kept so sbatch can write into it)
logs/*
!logs/.gitkeep

# Checkpoints belong in $SQUADQA_SCRATCH, never in the repo
*.pt
*.bin
*.safetensors
*.ckpt

__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Personal list of proposed plan and tooling changes, not yet adopted
plan_proposals.md

# Smoke-test results (slurm/smoke_test.sbatch and smoke runs of training code): kept on the cluster, never committed
results/*smoke*/
