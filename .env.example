# Your profile for one machine. Copy to .env (gitignored) and fill it in.
# Hyperparameters live in configs/, never here.

# Required on every machine; code stops with an error if one is missing.
# On Windows, write C:/Users/..., not the Git Bash form /c/Users/...: Python reads /c/... as C:\c\...
# Checkpoints and other large run outputs, kept out of the repo.
SQUADQA_SCRATCH=/path/to/scratch/cs4248
# Hugging Face model cache.
HF_HOME=/path/to/hf_cache

# Needed only on machines that reach the cluster remotely (.claude/skills/soc-cluster/soc.sh).
# Your SoC unix id, and your repo clone on the cluster, relative to your home directory (no ~).
SOC_USER=
SOC_REPO=project
# Optional: Slurm emails <soc unix id>@comp.nus.edu.sg about jobs sent with soc.sh submit, e.g. END,FAIL.
SOC_MAIL_TYPE=
